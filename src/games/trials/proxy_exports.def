    SteamFriends                     = steam_api_real.SteamFriends                     @28
    SteamGameServer                  = steam_api_real.SteamGameServer                  @29
    SteamGameServerApps              = steam_api_real.SteamGameServerApps              @30
    SteamGameServerHTTP              = steam_api_real.SteamGameServerHTTP              @31
    SteamGameServerNetworking        = steam_api_real.SteamGameServerNetworking        @32
    SteamGameServerStats             = steam_api_real.SteamGameServerStats             @33
    SteamGameServerUtils             = steam_api_real.SteamGameServerUtils             @34
    SteamGameServer_BSecure          = steam_api_real.SteamGameServer_BSecure          @35
    SteamGameServer_GetHSteamPipe    = steam_api_real.SteamGameServer_GetHSteamPipe    @36
    SteamGameServer_GetHSteamUser    = steam_api_real.SteamGameServer_GetHSteamUser    @37
    SteamGameServer_GetIPCCallCount  = steam_api_real.SteamGameServer_GetIPCCallCount  @38
