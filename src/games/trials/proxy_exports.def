LIBRARY steam_api

; The 56 exports of Trials Evolution Gold Edition's steam_api.dll (Steam
; 220160, datapack/), forwarded to the renamed original; ordinals follow it.
; trialsFMX.exe imports 13 of them by name.

EXPORTS
    GetHSteamPipe                    = steam_api_real.GetHSteamPipe                    @1
    GetHSteamUser                    = steam_api_real.GetHSteamUser                    @2
    SteamAPI_GetHSteamPipe           = steam_api_real.SteamAPI_GetHSteamPipe           @3
    SteamAPI_GetHSteamUser           = steam_api_real.SteamAPI_GetHSteamUser           @4
    SteamAPI_GetSteamInstallPath     = steam_api_real.SteamAPI_GetSteamInstallPath     @5
    SteamAPI_Init                    = steam_api_real.SteamAPI_Init                    @6
    SteamAPI_InitSafe                = steam_api_real.SteamAPI_InitSafe                @7
    SteamAPI_IsSteamRunning          = steam_api_real.SteamAPI_IsSteamRunning          @8
    SteamAPI_RegisterCallResult      = steam_api_real.SteamAPI_RegisterCallResult      @9
    SteamAPI_RegisterCallback        = steam_api_real.SteamAPI_RegisterCallback        @10
    SteamAPI_RestartAppIfNecessary   = steam_api_real.SteamAPI_RestartAppIfNecessary   @11
    SteamAPI_RunCallbacks            = steam_api_real.SteamAPI_RunCallbacks            @12
    SteamAPI_SetBreakpadAppID        = steam_api_real.SteamAPI_SetBreakpadAppID        @13
    SteamAPI_SetMiniDumpComment      = steam_api_real.SteamAPI_SetMiniDumpComment      @14
    SteamAPI_SetTryCatchCallbacks    = steam_api_real.SteamAPI_SetTryCatchCallbacks    @15
    SteamAPI_Shutdown                = steam_api_real.SteamAPI_Shutdown                @16
    SteamAPI_UnregisterCallResult    = steam_api_real.SteamAPI_UnregisterCallResult    @17
    SteamAPI_UnregisterCallback      = steam_api_real.SteamAPI_UnregisterCallback      @18
    SteamAPI_UseBreakpadCrashHandler = steam_api_real.SteamAPI_UseBreakpadCrashHandler @19
    SteamAPI_WriteMiniDump           = steam_api_real.SteamAPI_WriteMiniDump           @20
    SteamApps                        = steam_api_real.SteamApps                        @21
    SteamClient                      = steam_api_real.SteamClient                      @22
    SteamContentServer               = steam_api_real.SteamContentServer               @23
    SteamContentServerUtils          = steam_api_real.SteamContentServerUtils          @24
    SteamContentServer_Init          = steam_api_real.SteamContentServer_Init          @25
    SteamContentServer_RunCallbacks  = steam_api_real.SteamContentServer_RunCallbacks  @26
