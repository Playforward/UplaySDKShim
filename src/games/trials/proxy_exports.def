    SteamRemoteStorage               = steam_api_real.SteamRemoteStorage               @48
    SteamScreenshots                 = steam_api_real.SteamScreenshots                 @49
    SteamUser                        = steam_api_real.SteamUser                        @50
    SteamUserStats                   = steam_api_real.SteamUserStats                   @51
    SteamUtils                       = steam_api_real.SteamUtils                       @52
