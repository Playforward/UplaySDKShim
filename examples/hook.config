# Common networking policy. Copy this next to the game-specific shim DLL.
redirect_ip=127.0.0.1
bypass_tls_verify=1
playforward_launch=1

# FC4 discovery aid do not leave this enabled after identifying hosts.
redirect_all_dns=0

# Diagnostics (implemented only by the applicable game adapter).
capture_tcp=0
log_rdv_full=0
log_tcp_full=0
capture_ssl=0
capture_uplay=0
trace_uplay=1

# FC3 ticket/decode diagnostics for the current fc3-pc-2018 build.
trace_points=FC3_d3d11.dll:0x124bd90:ticket_finalize,FC3_d3d11.dll:0x1254590:install_entry,FC3_d3d11.dll:0x12268d0:decoder_ready,FC3_d3d11.dll:0x12268ec:decoder_width,FC3_d3d11.dll:0x12269e7:decoder_valid,FC3_d3d11.dll:0x12545b7:decode_return,FC3_d3d11.dll:0x12545d8:install_return,FC3_d3d11.dll:0x124a4b0:job_complete
dump_session_blob=0
trace_getprocaddr=0
trace_cng=0
trace_cng_payload=0
trace_game_log=0
trace_winhttp=0
dump_module=0
